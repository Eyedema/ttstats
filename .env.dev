# Django settings
DJANGO_ENV=dev
DEBUG=1
SECRET_KEY=dev-secret-key-not-for-production

# Database
# Set DATABASE_URL to develop against the Supabase clone of prod instead of the
# local SQLite file. Use the *session* pooler (port 5432) -- the transaction
# pooler on 6543 breaks Django's prepared statements. Put the real value in the
# untracked .env.dev.local, never here: this file is committed.
# DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-1-<region>.pooler.supabase.com:5432/postgres
DB_NAME=pingpong_dev
DB_USER=pingpong
DB_PASSWORD=pingpong
DB_HOST=db
DB_PORT=5432

# Hosts
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Redis
REDIS_URL=redis://redis:6379/1
