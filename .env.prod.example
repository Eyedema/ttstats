# Django settings
DJANGO_ENV=prod
DEBUG=0
SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING

# Database
DB_NAME=pingpong_prod
DB_USER=pingpong
DB_PASSWORD=CHANGE_ME
DB_HOST=db
DB_PORT=5432

# Hosts (comma-separated)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Postgres (for db service)
POSTGRES_DB=pingpong_prod
POSTGRES_USER=pingpong
POSTGRES_PASSWORD=CHANGE_ME

# Email settings
EMAIL_HOST=smtp.eu.mailgun.org
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=aaabbcccddeeeff
EMAIL_HOST_PASSWORD=aaabbcccddeeeff
DEFAULT_FROM_EMAIL=aaabbcccddeeeff

SITE_DOMAIN=yourdomain.com

# Redis
REDIS_URL=redis://:your_secure_password_here@redis:6379/1
REDIS_PASSWORD=your_secure_password_here
# Sentry error monitoring.
#
# Unset, the app is byte-identical to how it ran before: every send is a no-op
# and errors go to the console handler as usual. Setting the DSN is the whole
# switch.
SENTRY_DSN=
# Shown on every issue. Use a different value on a staging box so the two
# cannot be confused for each other.
SENTRY_ENVIRONMENT=production
# The commit SHA this image was built from. The deploy already pins WEB_IMAGE
# to one; passing the same value here is what makes "this started in ..."
# answerable. Without it every regression looks like it has always existed.
SENTRY_RELEASE=
# Performance tracing. 0.0 = errors only. Raise to 0.05-0.1 if you want span
# data; server think-time is 15-140ms today, so there is nothing to chase yet.
SENTRY_TRACES_SAMPLE_RATE=0.0
# 4xx statuses to report as events. EMPTY IS THE RIGHT DEFAULT -- see
# ttstats/sentry.py. 404 and 400 are mostly scanners and would bury the 500s
# this exists to surface. 403 is the one worth considering: the templates never
# render a control that produces one, so it means a forged POST or a
# permissions bug.
SENTRY_CAPTURE_4XX=
