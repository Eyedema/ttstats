# Off-host backup config (KAN-118, KAN-108). Copy to deploy/backup/backup.env
# on the VPS (gitignored), fill in, `chmod 600`. Sourced by backup.sh and
# restore_drill.sh as shell, so quote values with spaces. NO SECRETS IN THIS
# EXAMPLE: the real values live only on the VPS.

# --- where prod is -------------------------------------------------------
BACKUP_PROJECT_DIR=/root/ttstats          # the prod checkout (WORK_DIR)
BACKUP_COMPOSE_FILE=compose.prod.yml      # relative to BACKUP_PROJECT_DIR
BACKUP_DB_SERVICE=db
# Where `pg_restore --list` runs to verify a dump: "container" (inside the db
# service; the host has no pg_restore) or "host".
BACKUP_VERIFY_RUNNER=container

# --- encryption ------------------------------------------------------------
# Public keys only. Comma- or space-separated. The main key's private half
# never touches the VPS; the drill key is a second recipient whose private half
# lives on the VPS for restore_drill.sh only.
BACKUP_AGE_RECIPIENTS="age1<MAIN-PUBLIC-KEY>,age1<DRILL-PUBLIC-KEY>"
# ...or/and a file with one recipient per line (# comments allowed):
# BACKUP_AGE_RECIPIENTS_FILE=/root/ttstats-backup-recipients.txt

# --- remote ----------------------------------------------------------------
# An rclone remote and path. Cloudflare R2 (KAN-117); the `r2` remote is in
# rclone.conf, see README.md.
BACKUP_REMOTE="r2:ttstats-backups/ttstats"
# rclone config holding that remote's (write-only if possible) credentials.
# Unset = rclone's default (~/.config/rclone/rclone.conf).
# BACKUP_RCLONE_CONFIG=/root/.config/rclone/rclone.conf

# --- retention -------------------------------------------------------------
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4         # Sunday backups
BACKUP_KEEP_MONTHLY=6        # 1st-of-month backups
BACKUP_KEEP_ADHOC=10         # --tag backups (pre-deploy)
BACKUP_PARTIAL_MAX_AGE=24h   # stray .partial uploads older than this are deleted
BACKUP_LOCAL_DIR=/root/ttstats-backups   # encrypted local copies; "none" disables
BACKUP_LOCAL_KEEP=2
# BACKUP_TMPDIR=/tmp         # where the plaintext dump lives, briefly (mode 700)

# --- monitoring ------------------------------------------------------------
# Sentry cron monitor check-in URLs (Crons > monitor > "HTTP" setup), without
# ?status=. Optional: unset = no check-ins. A failing check-in never fails a run.
# SENTRY_CRON_URL_BACKUP=https://o<ORG>.ingest.sentry.io/api/<PROJECT>/cron/ttstats-backup/<PUBLIC_KEY>/
# SENTRY_CRON_URL_DRILL=https://o<ORG>.ingest.sentry.io/api/<PROJECT>/cron/ttstats-restore-drill/<PUBLIC_KEY>/

# --- restore drill (KAN-108) -----------------------------------------------
BACKUP_DRILL_IDENTITY=/root/.config/ttstats/drill.agekey   # chmod 600
# DRILL_IMAGE=postgres:16
# DRILL_MEMORY=512m
# DRILL_MIN_PERCENT=99          # restored row counts must be >= this % of prod's
# DRILL_MAX_MATCH_AGE_DAYS=2    # newest match older than this: warning (--strict-freshness: failure)
# DRILL_MAX_DUMP_AGE_HOURS=50   # newest daily/ object older than this: failure
# DRILL_TABLES="pingpong_match pingpong_pointevent pingpong_playerrating auth_user"
